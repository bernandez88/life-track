# Used by db:seed:local to create or rotate the local user's token.
# Never commit the copied .dev.vars file.
API_AUTH_TOKEN=replace-me-locally
ACCESS_CLIENT_ID=replace-me-after-creating-access-saas-app
ACCESS_CLIENT_SECRET=replace-me-after-creating-access-saas-app
ACCESS_TOKEN_URL=https://your-team.cloudflareaccess.com/cdn-cgi/access/sso/oidc/client-id/token
ACCESS_AUTHORIZATION_URL=https://your-team.cloudflareaccess.com/cdn-cgi/access/sso/oidc/client-id/authorization
ACCESS_JWKS_URL=https://your-team.cloudflareaccess.com/cdn-cgi/access/sso/oidc/client-id/jwks
COOKIE_ENCRYPTION_KEY=replace-with-a-random-local-value
