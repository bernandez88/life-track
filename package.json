{
  "name": "life-track",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Data Hub API on Cloudflare Workers and D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "vitest run && npm run test:integration",
    "test:integration": "npm run db:migrate:local && npm run db:seed:local && node tests/expenses.integration.mjs",
    "test:watch": "vitest",
    "db:migration:create": "wrangler d1 migrations create life-track-db",
    "db:migrations:list": "wrangler d1 migrations list life-track-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply life-track-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply life-track-db --remote",
    "db:seed:local": "node scripts/seed-local.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.27.0",
    "hono": "^4.13.9",
    "jose": "^6.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.4",
    "@types/node": "^24.6.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.137.0"
  }
}
